{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unisermo reference analysis v1",
  "type": "object",
  "required": [
    "surface",
    "analyses"
  ],
  "additionalProperties": false,
  "properties": {
    "surface": {
      "type": "string"
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "lemma",
          "status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "finite_verb",
              "nominal_case",
              "participle",
              "lexical_form",
              "kinship_relation",
              "cardinal_numeral",
              "iteration_counter",
              "ordinal_numeral",
              "multiplicative_factor",
              "genitive_pronoun",
              "focus_enclitic",
              "productive_derivation",
              "derived_adjective",
              "derived_property"
            ]
          },
          "lemma": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tense": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "person": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "number": {
            "type": "string"
          },
          "case": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999999999
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
          },
          "kinship": {
            "type": "object"
          },
          "path_from_ego": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "steps": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "string"
          },
          "canonical_form": {
            "type": "string"
          },
          "factor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999
          },
          "focus": {
            "type": "string"
          },
          "derivation": {
            "type": "object",
            "required": [
              "kind",
              "lemma",
              "base",
              "category",
              "affix",
              "affix_position",
              "operation",
              "status",
              "base_status"
            ],
            "properties": {
              "kind": {
                "const": "productive_derivation"
              },
              "lemma": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "verb",
                  "noun",
                  "adjective",
                  "property"
                ]
              },
              "affix": {
                "type": "string"
              },
              "affix_position": {
                "enum": [
                  "prefix",
                  "suffix"
                ]
              },
              "operation": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "productive_from_confirmed",
                  "productive_from_attested"
                ]
              },
              "base_status": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
