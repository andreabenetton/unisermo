{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unisermo reconciled lexicon (generated)",
  "type": "object", "required": ["schema", "entries"], "additionalProperties": false,
  "properties": {
    "schema": {"const": "unisermo/lexicon-index@1"},
    "entries": {"type": "array", "items": {
      "type": "object", "required": ["form", "status", "source", "categories"],
      "additionalProperties": false,
      "properties": {
        "form": {"type": "string", "pattern": "^[a-z]+$"},
        "status": {"enum": ["confirmed_lexicon", "decision_attested_not_indexed", "example_only"]},
        "source": {"type": "string"},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "meaning_en": {"type": "string"}, "meaning_it": {"type": "string"}, "origin": {"type": "string"}, "decision": {"type": "string"}
      }
    }}
  }
}
